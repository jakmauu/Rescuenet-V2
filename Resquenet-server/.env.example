# RescueNet reads these variables directly from the process environment.
RESCUENET_HOST=0.0.0.0
RESCUENET_PORT=5000
RESCUENET_DATABASE=/home/pi/rescuenet-server/rescuenet.db
RESCUENET_MQTT_HOST=127.0.0.1
RESCUENET_MQTT_PORT=1883
RESCUENET_MQTT_KEEPALIVE=60
RESCUENET_SERIAL_PORT=/dev/serial/by-id/usb-YOUR_GATEWAY_ID
RESCUENET_SERIAL_BAUD=115200
RESCUENET_SERIAL_RECONNECT_SECONDS=5
RESCUENET_NODE_ACTIVE_THRESHOLD_SECONDS=300
# Online Leaflet/OpenStreetMap view. Gateway coordinates are optional.
RESCUENET_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
RESCUENET_MAP_DEFAULT_LAT=-6.2000
RESCUENET_MAP_DEFAULT_LON=106.8167
RESCUENET_MAP_DEFAULT_ZOOM=13
RESCUENET_MAP_RECENT_SECONDS=30
RESCUENET_MAP_STALE_SECONDS=300
# RESCUENET_MAP_GATEWAY_LAT=-6.2000
# RESCUENET_MAP_GATEWAY_LON=106.8167
RESCUENET_MAP_GATEWAY_LABEL=RescueNet Gateway
RESCUENET_LOG_LEVEL=INFO
