    "expo-location": "~55.1.14",
    "expo-network": "~55.0.18",
    "expo-sqlite": "~55.0.20",
    "expo-system-ui": "~55.0.22",
    "expo-task-manager": "~55.0.20",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2"
  },
  "overrides": {
    "xcode": { "uuid": "11.1.1" }
  },
  "devDependencies": {
    "typescript": "~5.9.2",
